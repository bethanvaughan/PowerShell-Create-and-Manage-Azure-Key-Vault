# Interactive PowerShell Script for Azure Key Vault Management

# Set Colors for Output
$infoColor = "Cyan"
$errorColor = "Red"
$successColor = "Green"
$defaultColor = "White"

# Function to Set Console Color
function Set-ConsoleColor {
    param ([string]$Color)
    Write-Host "" -ForegroundColor $Color -NoNewline
}

# Welcome Message
Set-ConsoleColor $infoColor
Write-Host "Welcome to the Azure Key Vault Management Script" -ForegroundColor $infoColor
Set-ConsoleColor $defaultColor

# Get Resource Group Information
$resourceGroupName = Read-Host "Enter Resource Group Name (leave blank to create a new one)"
if (-not $resourceGroupName) {
    Set-ConsoleColor $infoColor
    Write-Host "Creating a new Resource Group..." -ForegroundColor $infoColor
    Set-ConsoleColor $defaultColor
    $resourceGroupName = Read-Host "Enter New Resource Group Name"
    $location = Read-Host "Enter Azure Location (e.g., eastus)"
    New-AzResourceGroup -Name $resourceGroupName -Location $location | Out-Null
    Set-ConsoleColor $successColor
    Write-Host "Resource Group '$resourceGroupName' created successfully."
    Set-ConsoleColor $defaultColor
} else {
    Write-Host "Using existing Resource Group: $resourceGroupName"
}

# Create or Select Key Vault
$vaultName = Read-Host "Enter Key Vault Name (leave blank to create a new one)"
if (-not $vaultName) {
    $vaultName = Read-Host "Enter New Key Vault Name"
    New-AzKeyVault -VaultName $vaultName -ResourceGroupName $resourceGroupName -Location $location | Out-Null
    Set-ConsoleColor $successColor
    Write-Host "Key Vault '$vaultName' created successfully."
    Set-ConsoleColor $defaultColor
} else {
    Write-Host "Using existing Key Vault: $vaultName"
}

# Secret Management
Write-Host "`n--- Secret Management ---"
$manageSecret = Read-Host "Do you want to add a new secret? (yes/no)"
if ($manageSecret -eq "yes") {
    $secretName = Read-Host "Enter Secret Name"
    $secretValue = Read-Host "Enter Secret Value"
    Set-AzKeyVaultSecret -VaultName $vaultName -Name $secretName -SecretValue (ConvertTo-SecureString $secretValue -AsPlainText -Force) | Out-Null
    Set-ConsoleColor $successColor
    Write-Host "Secret '$secretName' added to Key Vault."
    Set-ConsoleColor $defaultColor
}

# Key Management
Write-Host "`n--- Key Management ---"
$manageKey = Read-Host "Do you want to create a new key? (yes/no)"
if ($manageKey -eq "yes") {
    $keyName = Read-Host "Enter Key Name"
    Add-AzKeyVaultKey -VaultName $vaultName -Name $keyName -Destination "Software" | Out-Null
    Set-ConsoleColor $successColor
    Write-Host "Key '$keyName' created in Key Vault."
    Set-ConsoleColor $defaultColor
}

# Certificate Management
Write-Host "`n--- Certificate Management ---"
$manageCertificate = Read-Host "Do you want to create a new certificate? (yes/no)"
if ($manageCertificate -eq "yes") {
    $certName = Read-Host "Enter Certificate Name"
    $policy = Get-AzKeyVaultCertificatePolicy -DefaultPolicy
    Add-AzKeyVaultCertificate -VaultName $vaultName -Name $certName -Policy $policy | Out-Null
    Set-ConsoleColor $successColor
    Write-Host "Certificate '$certName' created in Key Vault."
    Set-ConsoleColor $defaultColor
}

# Summary
Set-ConsoleColor $successColor
Write-Host "`nAzure Key Vault setup and management complete!" -ForegroundColor $successColor
Set-ConsoleColor $defaultColor
